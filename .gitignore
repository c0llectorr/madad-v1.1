# ============================================================
# MADAD — consolidated .gitignore
# ============================================================

# ---- Secrets & environment (never commit) ----
.env
.env.*
!.env.example
backend/.env
mobile/.env

# ---- Python ----
__pycache__/
*.py[cod]
venv/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Node / Expo / React Native ----
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
*.tsbuildinfo

# ---- Native build artifacts ----
android/
ios/
.kotlin/
*.apk
*.aab
*.ipa
*.jks
*.keystore
*.mobileprovision
*.p8
*.p12
*.pem
*.orig.*

# ---- OS junk ----
.DS_Store
Thumbs.db
desktop.ini

# ---- IDE ----
.vscode/
.idea/
*.swp

# ---- Logs & temp ----
*.log
*.tmp
nohup.out

# ---- Project-specific ----
.md_files/
.zcode/
cache/
build/

# ---- Process docs & design sources (not needed to run the app) ----
STATUS.md
MOBILE_TESTING_GUIDE.md
FRONTEND_MAINTENANCE.md
DRIVER_FEATURE_PLAN.md
WRITEUP.md
MADAD_UI/
MADAD NEW UI/
mobile/AGENTS.md
mobile/CLAUDE.md
mobile/.claude/
